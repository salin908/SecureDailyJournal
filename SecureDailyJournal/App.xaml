<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SecureDailyJournal"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:SecureDailyJournal.Converters"
             x:Class="SecureDailyJournal.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:PinDotConverter x:Key="PinDotConverter" />

            <!-- Tag Button Style -->
            <Style x:Key="TagButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HeightRequest" Value="35"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E3F2FD, Dark=#1E3A5F}"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1976D2, Dark=#90CAF9}"/>
                <Setter Property="CornerRadius" Value="15"/>
            </Style>

            <!-- Mood Button Style -->
            <Style x:Key="MoodButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="BorderColor" Value="{StaticResource Gray200}"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}"/>
                <Setter Property="Margin" Value="2"/>
            </Style>
            
            <!-- Numeric Keypad Button Style -->
            <Style x:Key="NumPadButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="35"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"/>
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="Shadow">
                    <Shadow Brush="#20000000" Offset="0,2" Radius="4" />
                </Setter>
            </Style>
            
            <!-- Numeric Keypad Secondary Style (Backspace) -->
            <Style x:Key="NumPadSecondaryStyle" TargetType="Button">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="CornerRadius" Value="35"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1F5F9, Dark=#334155}"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
            </Style>
            
            <!-- Numeric Keypad Primary Style (Submit) -->
            <Style x:Key="NumPadPrimaryStyle" TargetType="Button">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="CornerRadius" Value="35"/>
                <Setter Property="BackgroundColor" Value="#6366F1"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Shadow">
                    <Shadow Brush="#406366F1" Offset="0,4" Radius="8" />
                </Setter>
            </Style>
            
            <!-- Primary Action Button -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#6366F1"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20,15"/>
                <Setter Property="Shadow">
                    <Shadow Brush="#306366F1" Offset="0,4" Radius="8" />
                </Setter>
            </Style>
            
            <!-- Secondary Action Button -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1F5F9, Dark=#334155}"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20,15"/>
            </Style>
            
            <!-- Card Frame Style -->
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"/>
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="HasShadow" Value="True"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
